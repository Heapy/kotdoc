cabal-version: 3.0
name: kotdoc-keyed-pool-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable keyed-pool-reference
  main-is: KeyedPoolReference.hs
  other-modules: OriginalKeyedPool, LiveKeyedPool, PoolClock
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19, aeson ==2.2.3.0,
                 bytestring ==0.12.2.0, time ==1.14, containers, stm
