cabal-version: 3.0
name: kotdoc-types-vector-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable types-vector-reference
  main-is: TypesVectorReference.hs
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring,
                 QuickCheck ==2.16.0.0
