cabal-version: 3.0
name: kotdoc-grid-table-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable grid-table-reference
  main-is: GridTableReference.hs
  hs-source-dirs: ., ../haskell-model-show-reference, ../../upstream/pandoc/src,
                 ../../vendor/doctemplates-0.11.1/src, ../../vendor/doclayout-0.6/src,
                 ../../vendor/skylighting-core-0.15/src, ../../vendor/utf8-string-1.0.2
  include-dirs: ../../vendor/doclayout-0.6/src/Text
  other-modules: SourceGridTable, PandocOptionsModels, TemplateAdapter,
                 Text.Pandoc.Writers.AnnotatedTable, Text.DocTemplates,
                 Text.DocTemplates.Internal, Text.DocTemplates.Parser,
                 Text.DocLayout, Text.DocLayout.HasChars, Text.DocLayout.Attributed,
                 Text.DocLayout.ANSIFont, Skylighting.Types, Skylighting.Regex,
                 Regex.KDE, Regex.KDE.Regex, Regex.KDE.Compile, Regex.KDE.Match,
                 Data.ByteString.UTF8, Codec.Binary.UTF8.Generic, Codec.Binary.UTF8.String
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, text ==2.1.2, containers, emojis ==0.1.5,
                 mtl, safe, aeson ==2.2.3.0, bytestring ==0.12.2.0, vector,
                 text-conversions, filepath ==1.5.4.0, parsec ==3.1.18.0, scientific,
                 binary, attoparsec, base64-bytestring, colour, data-default,
                 case-insensitive, transformers, syb, pandoc-types ==1.23.1.2
