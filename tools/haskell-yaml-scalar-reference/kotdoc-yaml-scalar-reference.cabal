cabal-version: 3.0
name: kotdoc-yaml-scalar-reference
version: 0.1.0.0
build-type: Simple
license: BSD-2-Clause
executable yaml-scalar-reference
  main-is: YamlScalarReference.hs
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, scientific ==0.3.9.0,
                 text ==2.1.2, bytestring ==0.12.2.0, vector, yaml ==0.11.11.2,
                 libyaml ==0.1.4, conduit ==1.3.6.1
