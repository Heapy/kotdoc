cabal-version: 3.0
name: kotdoc-http-windows-proxy-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable http-windows-proxy-reference
  main-is: HttpWindowsProxyReference.hs
  other-modules: OriginalWindowsProxy ProxyEffects ProxyRegistry ProxyRegistryTypes ProxyProjection
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19,
                 aeson ==2.2.3.0, bytestring ==0.12.2.0, text ==2.1.2,
                 network-uri ==2.6.4.2, containers ==0.7, case-insensitive, safe ==0.3.21
