cabal-version: 3.0
name: kotdoc-modular-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable modular-reference
  main-is: ModularReference.hs
  hs-source-dirs: . ../../vendor/crypton-2.0.1/tests
  other-modules: NumberSpec, Imports, Utils, OriginalNumberTests
  c-sources: LimbReference.c
  include-dirs: ../../vendor/crypton-2.0.1/cbits
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, crypton ==2.0.1, aeson ==2.2.3.0, bytestring ==0.12.2.0, text, ram, QuickCheck ==2.16.0.0, hspec ==2.11.18
