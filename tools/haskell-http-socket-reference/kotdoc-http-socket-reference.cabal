cabal-version: 3.0
name: kotdoc-http-socket-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable http-socket-reference
  main-is: HttpSocketReference.hs
  other-modules: OriginalSocketConnection, OriginalSocketFactories, SocketEffects
  default-language: Haskell2010
  ghc-options: -O2 -threaded -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19, network ==3.2.9.0,
                 async ==2.2.6, aeson ==2.2.3.0, bytestring ==0.12.2.0,
                 containers ==0.7, text ==2.1.2
