cabal-version: 3.0
name: kotdoc-writer-metadata-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable writer-metadata-reference
  main-is: WriterMetadataReference.hs
  hs-source-dirs: ., ../haskell-model-show-reference, ../haskell-writer-html-reference,
                 ../../upstream/pandoc/src, ../../vendor/doctemplates-0.11.1/src,
                 ../../vendor/doclayout-0.6/src, ../../vendor/skylighting-core-0.15/src,
                 ../../vendor/utf8-string-1.0.2, ../../vendor/tagsoup-0.14.8/src
  include-dirs: ../../vendor/doclayout-0.6/src/Text
  other-modules: SourceWriterMetadata, PandocOptionsModels, TemplateAdapter,
                 SourceWriterHtml, SourceCss, Text.Pandoc.XML, Text.Pandoc.UTF8,
                 Text.HTML.TagSoup.Entity, Text.DocTemplates, Text.DocTemplates.Internal,
                 Text.DocTemplates.Parser, Text.DocLayout, Text.DocLayout.HasChars,
                 Text.DocLayout.Attributed, Text.DocLayout.ANSIFont, Skylighting.Types, Skylighting.Regex,
                 Regex.KDE, Regex.KDE.Regex, Regex.KDE.Compile, Regex.KDE.Match,
                 Data.ByteString.UTF8, Codec.Binary.UTF8.Generic, Codec.Binary.UTF8.String
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, text ==2.1.2, containers, emojis ==0.1.5,
                 mtl, safe, aeson ==2.2.3.0, bytestring ==0.12.2.0, vector,
                 text-conversions, filepath ==1.5.4.0, parsec ==3.1.18.0, scientific,
                 binary, attoparsec, base64-bytestring, colour, data-default, case-insensitive,
                 transformers, pandoc-types ==1.23.1.2, commonmark ==0.3.1
