cabal-version: 3.0
name: kotdoc-types-many-derived-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable types-many-derived-reference
  main-is: ManyDerivedReference.hs
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, text ==2.1.2, containers ==0.7, bytestring

executable types-many-derived-demand
  main-is: ManyDerivedDemand.hs
  default-language: Haskell2010
