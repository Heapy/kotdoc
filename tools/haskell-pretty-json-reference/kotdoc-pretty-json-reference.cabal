cabal-version: 3.0
name: kotdoc-pretty-json-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable pretty-json-reference
  main-is: PrettyJsonReference.hs
  other-modules: OriginalGenerator
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, aeson-pretty ==0.8.11,
                 scientific ==0.3.9.0, text ==2.1.2, bytestring, vector,
                 QuickCheck ==2.16.0.0
