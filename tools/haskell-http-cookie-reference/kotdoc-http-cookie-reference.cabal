cabal-version: 3.0
name: kotdoc-http-cookie-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable http-cookie-reference
  main-is: HttpCookieReference.hs
  other-modules: OriginalCookieSpec, Test.Hspec
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19, cookie ==0.5.1,
                 http-types ==0.12.6, aeson ==2.2.3.0, text ==2.1.2, time ==1.14,
                 bytestring ==0.12.2.0, iproute ==1.7.15, case-insensitive, vector
