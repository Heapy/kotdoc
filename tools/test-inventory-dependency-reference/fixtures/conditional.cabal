cabal-version: 3.0
name: inventory-parser-fixture
version: 1.0
build-type: Simple
flag alternate
  default: False
common shared
  hs-source-dirs: source-common
  default-language: Haskell2010
  build-depends: base
library
  import: shared
  exposed-modules: Example
test-suite conditional
  import: shared
  type: exitcode-stdio-1.0
  main-is: Main.hs
  if flag(alternate)
    hs-source-dirs: alternate
    if os(windows)
      buildable: False
    else
      cpp-options: -DNOT_WINDOWS
  else
    hs-source-dirs: ordinary
executable separate-runner
  import: shared
  main-is: Runner.hs
