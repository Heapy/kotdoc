cabal-version: 3.0
name: kotdoc-types-generic-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable types-generic-reference
  main-is: TypesGenericReference.hs
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, text ==2.1.2, containers ==0.7,
                 bytestring, mtl, syb ==0.7.4

