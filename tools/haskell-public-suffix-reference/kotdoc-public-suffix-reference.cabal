cabal-version: 3.0
name: kotdoc-public-suffix-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable public-suffix-reference
  main-is: PublicSuffixReference.hs
  hs-source-dirs: ., ../../vendor/http-client-0.7.19/publicsuffixlist
  other-modules: Network.PublicSuffixList.Types, Network.PublicSuffixList.Lookup,
                 Network.PublicSuffixList.Serialize, Network.PublicSuffixList.DataStructure
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, text ==2.1.2,
                 bytestring ==0.12.2.0, blaze-builder ==0.4.4.1, containers
