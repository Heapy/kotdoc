cabal-version: 3.0
name: kotdoc-asn1-typed-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
common observer
  hs-source-dirs: . ../../vendor/time-hourglass-0.3.0/src
  hs-source-dirs: ../../vendor/crypton-asn1-types-0.4.1/src ../../vendor/crypton-asn1-encoding-0.10.0/src
  other-modules: UpstreamTests, Data.ASN1.Types, Data.ASN1.Types.Lowlevel, Data.ASN1.Types.String, Data.ASN1.BitArray, Data.ASN1.Stream, Data.ASN1.OID, Data.ASN1.Error, Data.ASN1.Encoding, Data.ASN1.BinaryEncoding, Data.ASN1.BinaryEncoding.Parse, Data.ASN1.BinaryEncoding.Raw, Data.ASN1.BinaryEncoding.Writer, Data.ASN1.Get, Data.ASN1.Internal, Data.ASN1.Prim, Data.ASN1.Serialize, Data.Hourglass, Time.Calendar, Time.Diff, Time.Epoch, Time.Format, Time.Internal, Time.LocalTime, Time.System, Time.Time, Time.Timezone, Time.Types, Time.Utils
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring ==0.12.2.0, deepseq, time, vector, text, ghc-bignum ==1.3, QuickCheck, tasty, tasty-quickcheck
executable asn1-typed-reference
  import: observer
  main-is: Asn1TypedReference.hs
  hs-source-dirs: ../../vendor/time-hourglass-0.3.0/src/unix
  c-sources: ../../vendor/time-hourglass-0.3.0/cbits/unix.c
executable asn1-typed-posix-model
  import: observer
  main-is: Asn1TypedReference.hs
  hs-source-dirs: ../haskell-hourglass-reference/posix-model ../../vendor/time-hourglass-0.3.0/src/unix
  other-modules: Model
  cpp-options: -DMODEL=1
  c-sources: ../haskell-hourglass-reference/posix-model/clock.c
executable asn1-typed-windows-model
  import: observer
  main-is: Asn1TypedReference.hs
  hs-source-dirs: ../haskell-hourglass-reference/windows-model ../../vendor/time-hourglass-0.3.0/src/win
  other-modules: Model, System.Win32.Time
  cpp-options: -DMODEL=1

executable original-asn1-tests
  import: observer
  main-is: Tests.hs
  hs-source-dirs: ../../vendor/crypton-asn1-encoding-0.10.0/tests ../../vendor/time-hourglass-0.3.0/src/unix
  c-sources: ../../vendor/time-hourglass-0.3.0/cbits/unix.c
