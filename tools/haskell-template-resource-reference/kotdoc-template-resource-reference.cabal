cabal-version: 3.0
name: kotdoc-template-resource-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable template-paths-reference
  main-is: TemplatePaths.hs
  hs-source-dirs: ., ../../vendor/filepath-1.5.4.0
  include-dirs: ../../vendor/filepath-1.5.4.0/System/FilePath
  other-modules: CanonicalPosix, CanonicalWindows,
                 System.FilePath.Posix, System.FilePath.Windows
  default-language: Haskell2010
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring, text, vector
