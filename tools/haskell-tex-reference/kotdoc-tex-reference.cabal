cabal-version: 3.0
name: kotdoc-tex-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable tex-reference
  main-is: TeXReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/src
  other-modules: Text.Pandoc.TeX, Text.Pandoc.Sources
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, text ==2.1.2, containers,
                 aeson ==2.2.3.0, bytestring ==0.12.2.0, vector,
                 parsec ==3.1.18.0, transformers
