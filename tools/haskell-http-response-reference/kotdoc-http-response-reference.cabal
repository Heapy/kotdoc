cabal-version: 3.0
name: kotdoc-http-response-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable http-response-reference
  main-is: HttpResponseReference.hs
  other-modules: OriginalHeadersSpec, OriginalBodySpec, OriginalResponseSpec, OriginalConnectionSpec, Test.Hspec, OriginalResponse, ObserverManaged
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19,
                 http-types ==0.12.6, aeson ==2.2.3.0, text ==2.1.2,
                 bytestring ==0.12.2.0, network-uri ==2.6.4.2,
                 case-insensitive, blaze-builder, containers, vector, directory, zlib, streaming-commons
