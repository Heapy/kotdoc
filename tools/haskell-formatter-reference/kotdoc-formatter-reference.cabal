cabal-version: 3.0
name: kotdoc-formatter-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable formatter-reference
  hs-source-dirs: ., ../../vendor/skylighting-core-0.15/src, ../../vendor/utf8-string-1.0.2,
                 ../../vendor/skylighting-format-ansi-0.1/src, ../../vendor/skylighting-format-blaze-html-0.1.2.2/src,
                 ../../vendor/skylighting-format-latex-0.1/src, ../../vendor/skylighting-format-context-0.1.0.2/src,
                 ../../vendor/skylighting-format-typst-0.1/src
  main-is: FormatterReference.hs
  other-modules: Skylighting.Core, Skylighting.Types, Skylighting.Regex,
                 Skylighting.Styles, Skylighting.Parser, Skylighting.Loader,
                 Skylighting.Tokenizer, Regex.KDE, Regex.KDE.Regex,
                 Regex.KDE.Compile, Regex.KDE.Match, Data.ByteString.UTF8,
                 Codec.Binary.UTF8.Generic, Codec.Binary.UTF8.String,
                 Skylighting.Format.ANSI, Skylighting.Format.HTML, Skylighting.Format.LaTeX,
                 Skylighting.Format.ConTeXt, Skylighting.Format.Typst
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring, text, containers,
                 vector, binary, attoparsec, safe, mtl, base64-bytestring, colour,
                 transformers, case-insensitive, directory, filepath, xml-conduit, ansi-terminal ==1.1.5, blaze-html ==0.9.2.0
