cabal-version: 3.0
name: kotdoc-error-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable error-reference
  main-is: ErrorReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/src
  other-modules: Text.Pandoc.Error, Text.Pandoc.UTF8, Text.Pandoc.Shared, Citeproc
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m -ddump-deriv -ddump-to-file
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, text ==2.1.2,
                 bytestring ==0.12.2.0, vector, directory, filepath, temporary
