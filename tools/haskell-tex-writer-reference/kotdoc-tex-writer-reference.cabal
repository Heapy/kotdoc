cabal-version: 3.0
name: kotdoc-tex-writer-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable tex-writer-reference
  main-is: TeXWriterReference.hs
  other-modules: MathWire
  hs-source-dirs: ., ../haskell-math-reader-reference
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, texmath ==0.13.3.1, xml ==1.3.14,
                 pandoc-types ==1.23.1.2, aeson ==2.2.3.0, text ==2.1.2,
                 bytestring ==0.12.2.0, vector, containers ==0.7, pretty-show,
                 tasty, tasty-golden, directory, filepath, binary ==0.8.9.3, crypton >=0.30 && <2.1
executable original-texmath-tests
  main-is: test-texmath.hs
  hs-source-dirs: ../../vendor/texmath-0.13.3.1/test
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, texmath ==0.13.3.1, xml ==1.3.14,
                 text ==2.1.2, bytestring ==0.12.2.0, pretty-show,
                 tasty, tasty-golden, directory, filepath
