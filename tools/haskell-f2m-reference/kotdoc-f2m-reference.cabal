cabal-version: 3.0
name: kotdoc-f2m-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable f2m-reference
  main-is: F2mReference.hs
  hs-source-dirs: . ../../vendor/crypton-2.0.1/tests
  other-modules: Number.F2mSpec, Imports, Utils, OriginalF2mProperties
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, crypton ==2.0.1, aeson ==2.2.3.0, bytestring ==0.12.2.0, text, ram, QuickCheck ==2.16.0.0, hspec
