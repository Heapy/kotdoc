cabal-version: 3.0
name: kotdoc-logging-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable logging-reference
  main-is: LoggingReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/src
  other-modules: Text.Pandoc.Logging, Text.Pandoc.Shared
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m -ddump-deriv -ddump-to-file
  build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, aeson-pretty ==0.8.11, scientific ==0.3.9.0,
                 text ==2.1.2, bytestring ==0.12.2.0, vector, parsec ==3.1.18.0
