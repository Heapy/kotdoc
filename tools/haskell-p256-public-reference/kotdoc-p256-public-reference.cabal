cabal-version: 3.0
name: kotdoc-p256-public-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable p256-public-reference
  main-is: P256PublicReference.hs
  hs-source-dirs: . ../../vendor/crypton-2.0.1/tests
  other-modules: OriginalP256Spec, Imports, Utils
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, crypton ==2.0.1, aeson ==2.2.3.0, bytestring ==0.12.2.0, text, ram ==0.22.1, QuickCheck ==2.16.0.0, hspec ==2.11.18, deepseq, transformers
