cabal-version: 3.0
name: kotdoc-html-reader-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable html-reader-reference
  main-is: HTMLReaderReference.hs
  other-modules: OriginalReaderTests, ReaderCases, OriginalSmart
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, pandoc ==3.12.1, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, text ==2.1.2, bytestring ==0.12.2.0,
                 containers ==0.7, data-default, parsec ==3.1.18.0,
                 mtl, transformers, time ==1.14, vector, QuickCheck ==2.16.0.0, tagsoup ==0.14.8, binary ==0.8.9.3, crypton
