cabal-version: 3.0
name: kotdoc-connection-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable connection-reference
  main-is: ConnectionReference.hs
  other-modules: OriginalConnection, OriginalConnectionTypes, ConnectionTlsEffects
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring ==0.12.2.0,
                 tls ==2.4.6, crypton-socks ==0.6.2, crypton-x509-store ==1.9.0,
                 crypton-x509-system ==1.9.0, data-default, network ==3.2.9.0,
                 text ==2.1.2, containers ==0.7, directory
