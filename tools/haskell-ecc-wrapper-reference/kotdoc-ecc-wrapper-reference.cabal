cabal-version: 3.0
name: kotdoc-ecc-wrapper-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable ecc-wrapper-reference
  main-is: EccWrapperReference.hs
  hs-source-dirs: . ../haskell-ecc-prime-reference ../../vendor/crypton-2.0.1/tests
  other-modules: ObservedECC, ObservedSerialize, ObservedNumberCompat, ObservedCompat, ObserverMemory, OriginalEccTests, Imports, Utils
  c-sources: WrapperReference.c
  include-dirs: ../../vendor/crypton-2.0.1/cbits
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, crypton ==2.0.1, aeson ==2.2.3.0, bytestring ==0.12.2.0, text, ram, integer-gmp ==1.1, QuickCheck ==2.16.0.0, hspec ==2.11.18
