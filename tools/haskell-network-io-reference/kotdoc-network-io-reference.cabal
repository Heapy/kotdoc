cabal-version: 3.0
name: kotdoc-network-io-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable network-io-reference
  main-is: NetworkIoReference.hs
  other-modules: OriginalSend
  default-language: Haskell2010
  ghc-options: -O2 -threaded -rtsopts
  build-depends: base >=4.21 && <4.22, ghc-internal ==9.1202.0,
                 network ==3.2.9.0, aeson ==2.2.3.0, bytestring ==0.12.2.0,
                 text ==2.1.2, containers ==0.7
