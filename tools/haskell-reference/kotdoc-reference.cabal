cabal-version: 3.0
name: kotdoc-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only

executable bitstream-reference
  main-is: BitStream.hs
  hs-source-dirs: ., ../../vendor/JuicyPixels-3.3.9/src
  other-modules:
    Codec.Picture.BitWriter
    Codec.Picture.VectorByteConversion
    Codec.Picture.Types
  include-dirs: ../../vendor/JuicyPixels-3.3.9/src/Codec/Picture
  default-language: Haskell2010
  default-extensions: TypeOperators
  ghc-options: -O2
  build-depends:
    base >=4.21 && <4.22,
    bytestring,
    deepseq,
    transformers,
    primitive,
    vector
