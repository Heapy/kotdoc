cabal-version: 3.0
name: kotdoc-html-writer-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable html-writer-reference
  main-is: HtmlWriterReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/test
  other-modules: OriginalHelpers, Tests.Helpers, Tests.Writers.HTML
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, pandoc ==3.12.1, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, text ==2.1.2, bytestring ==0.12.2.0,
                 containers ==0.7, data-default, blaze-html, blaze-markup,
                 doctemplates ==0.11.1, doclayout ==0.6, skylighting ==0.15,
                 skylighting-core ==0.15, mtl, transformers, vector, tasty, tasty-hunit, tasty-golden, Diff, filepath
