cabal-version: 3.0
name: kotdoc-math-reader-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable math-reader-reference
  main-is: MathReaderReference.hs
  other-modules: MathWire, Text.TeXMath.Readers.TeX.Commands
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
  build-depends: base >=4.21 && <4.22, texmath ==0.13.3.1, pandoc-types ==1.23.1.2,
                 aeson ==2.2.3.0, text ==2.1.2, bytestring ==0.12.2.0,
                 vector, containers ==0.7, pretty-show, binary ==0.8.9.3, crypton >=0.30 && <2.1
