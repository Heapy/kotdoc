cabal-version: 3.0
name: kotdoc-http-tls-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable http-tls-reference
  main-is: HttpTlsReference.hs
  other-modules: OriginalHttpTls, ConnectionEffects, TlsEffects, Effects, HttpRedirectProjection, OriginalTlsError
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19, http-types ==0.12.6,
                 aeson ==2.2.3.0, bytestring ==0.12.2.0, time ==1.14, case-insensitive,
                 crypton-connection ==0.4.6, tls ==2.4.6, base16 ==1.0, cryptohash-md5,
                 data-default, network, text ==2.1.2, containers ==0.7, exceptions, network-uri
