cabal-version: 3.0
name: kotdoc-connection-dial-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable connection-dial-reference
  main-is: ConnectionDialReference.hs
  other-modules: OriginalConnection, OriginalConnectionTypes, ConnectionTlsEffects,
                 OriginalSocks, OriginalSocksCommand, OriginalSocksConf, OriginalSocksTypes,
                 OriginalSocksWire, OriginalSocksLowlevel, SocksSocketEffects,
                 ConnectionSocketEffects, ConnectionEnvironmentEffects, DialEffects
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring ==0.12.2.0,
                 tls ==2.4.6, crypton-x509-store ==1.9.0, crypton-x509-system ==1.9.0,
                 data-default, network ==3.2.9.0, cereal ==0.5.8.3, text ==2.1.2,
                 containers ==0.7, directory
