cabal-version: 3.0
name: kotdoc-future-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable future-reference
  main-is: FutureReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/src
  other-modules: Text.Pandoc.Parsing.Future
  default-language: Haskell2010
  ghc-options: -O2
  build-depends: base >=4.21 && <4.22, text ==2.1.2, mtl ==2.3.1,
                 transformers ==0.6.1.2, aeson ==2.2.3.0, bytestring,
                 vector, deepseq, containers
