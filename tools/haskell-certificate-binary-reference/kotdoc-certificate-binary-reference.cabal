cabal-version: 3.0
name: kotdoc-certificate-binary-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
flag upstream-tests
  default: False
  manual: True
executable certificate-binary-reference
  main-is: CertificateBinaryReference.hs
  hs-source-dirs: . ../../vendor/crypton-asn1-encoding-0.10.0/src ../../vendor/crypton-asn1-types-0.4.1/src ../../vendor/crypton-pem-0.3.0/src ../../vendor/base64-1.0/src
  other-modules: Data.ASN1.BinaryEncoding.Raw, Data.ASN1.BinaryEncoding.Parse, Data.ASN1.BinaryEncoding.Writer, Data.ASN1.Error, Data.ASN1.Get, Data.ASN1.Internal, Data.ASN1.Serialize, Data.ASN1.Types.Lowlevel,
                 Data.PEM, Data.PEM.Types, Data.PEM.Parser, Data.PEM.Writer,
                 Data.Base64.Types, Data.Base64.Types.Internal, Data.ByteString.Base64, Data.ByteString.Base64.Internal, Data.ByteString.Base64.Internal.Head, Data.ByteString.Base64.Internal.Tail, Data.ByteString.Base64.Internal.Utils, Data.ByteString.Base64.Internal.W16.Loop, Data.ByteString.Base64.Internal.W64.Loop, Data.ByteString.Base64.Internal.Tables
  default-language: Haskell2010
  ghc-options: -O2
  cpp-options: -DMIN_VERSION_base64(a,b,c)=1
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0, bytestring ==0.12.2.0, text ==2.1.2, deepseq

executable original-pem-tests
  if !flag(upstream-tests)
    buildable: False
  main-is: Main.hs
  hs-source-dirs: ../../vendor/crypton-pem-0.3.0/test ../../vendor/crypton-pem-0.3.0/src ../../vendor/base64-1.0/src
  other-modules: Data.PEM, Data.PEM.Types, Data.PEM.Parser, Data.PEM.Writer,
                 Data.Base64.Types, Data.Base64.Types.Internal, Data.ByteString.Base64, Data.ByteString.Base64.Internal, Data.ByteString.Base64.Internal.Head, Data.ByteString.Base64.Internal.Tail, Data.ByteString.Base64.Internal.Utils, Data.ByteString.Base64.Internal.W16.Loop, Data.ByteString.Base64.Internal.W64.Loop, Data.ByteString.Base64.Internal.Tables
  default-language: Haskell2010
  ghc-options: -O2
  cpp-options: -DMIN_VERSION_base64(a,b,c)=1
  build-depends: base >=4.21 && <4.22, bytestring ==0.12.2.0, text ==2.1.2, deepseq, HUnit, QuickCheck >=2.4.0.1, test-framework >=0.3.3, test-framework-hunit, test-framework-quickcheck2
