cabal-version: 3.0
name: kotdoc-translations-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only
executable translations-reference
  main-is: TranslationsReference.hs
  hs-source-dirs: ., ../../upstream/pandoc/src
  other-modules: Text.Pandoc.Translations.Types
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts -with-rtsopts=-K256m -ddump-deriv -ddump-to-file
  build-depends: base >=4.21 && <4.22, aeson ==2.2.3.0,
                 text ==2.1.2, bytestring ==0.12.2.0, vector, containers ==0.7,
                 yaml ==0.11.11.2
