cabal-version: 3.0
name: kotdoc-http-redirect-reference
version: 0.1.0.0
build-type: Simple
license: MIT
executable http-redirect-reference
  main-is: HttpRedirectReference.hs
  default-language: Haskell2010
  ghc-options: -O2 -rtsopts
  build-depends: base >=4.21 && <4.22, http-client ==0.7.19, http-types ==0.12.6,
                 aeson ==2.2.3.0, bytestring ==0.12.2.0, time ==1.14, case-insensitive
