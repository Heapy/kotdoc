cabal-version: 3.0
name: kotdoc-types-deepseq-reference
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
executable types-deepseq-reference
 main-is: DeepSeqReference.hs
 default-language: Haskell2010
 ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
 build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2, deepseq ==1.5.1.0, aeson ==2.2.3.0, bytestring, text ==2.1.2, containers ==0.7
executable types-deepseq-demand
 main-is: DeepSeqDemand.hs
 default-language: Haskell2010
 ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
 build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2, deepseq ==1.5.1.0, aeson ==2.2.3.0, bytestring, text ==2.1.2, containers ==0.7
executable types-deepseq-extended
 main-is: DeepSeqExtended.hs
 default-language: Haskell2010
 ghc-options: -O2 -rtsopts -with-rtsopts=-K256m
 build-depends: base >=4.21 && <4.22, pandoc-types ==1.23.1.2, deepseq ==1.5.1.0, aeson ==2.2.3.0, bytestring, text ==2.1.2, containers ==0.7
