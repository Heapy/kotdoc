cabal-version: 3.0
name: kotdoc-doclayout-reference
version: 0.1.0.0
build-type: Simple
license: GPL-3.0-only

executable doclayout-reference
  main-is: DocLayoutReference.hs
  hs-source-dirs: ., ../../vendor/doclayout-0.6/src
  include-dirs: ../../vendor/doclayout-0.6/src/Text
  other-modules: Text.DocLayout, Text.DocLayout.HasChars,
                 Text.DocLayout.Attributed, Text.DocLayout.ANSIFont
  default-language: Haskell2010
  build-depends: base >=4.21 && <4.22, text, containers, emojis ==0.1.5,
                 mtl, safe, aeson ==2.2.3.0, bytestring, vector, QuickCheck

test-suite original-doclayout-tests
  type: exitcode-stdio-1.0
  main-is: test.hs
  hs-source-dirs: ../../vendor/doclayout-0.6/test, ../../vendor/doclayout-0.6/src
  include-dirs: ../../vendor/doclayout-0.6/src/Text
  other-modules: Text.DocLayout, Text.DocLayout.HasChars,
                 Text.DocLayout.Attributed, Text.DocLayout.ANSIFont
  default-language: Haskell2010
  build-depends: base, text, containers, emojis ==0.1.5, mtl, safe,
                 tasty, tasty-golden, tasty-hunit, tasty-quickcheck
